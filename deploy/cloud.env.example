# Copy to deploy/cloud.env on the Droplet. Never commit the filled-in file.
CUTROOM_DOMAIN=cutroom.tech
POSTGRES_PASSWORD=change-me

NODE_ENV=production
LOG_LEVEL=info

# Login (required: the API is public). Seeds the admin on first boot; CUTROOM_ADMIN_RESET=true
# re-applies the password on the next boot. Session secret: openssl rand -base64 48
CUTROOM_ADMIN_EMAIL=
CUTROOM_ADMIN_PASSWORD=
CUTROOM_SESSION_SECRET=
CUTROOM_PUBLIC_URL=https://cutroom.tech

# Cloud mode (public repos): Gemma behind vLLM's OpenAI-compatible API (deploy/gemma-vllm.sh).
OPENAI_COMPAT_BASE_URL=http://gpu-droplet-private-ip:8000/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL_ID=
# A GPU-free demo of the shipnote fixture instead: MODEL_PROVIDER=scripted-shipnote
MODEL_PROVIDER=auto

# Optional
ELEVENLABS_API_KEY=
SENTRY_DSN=
EMBEDDINGS=off

# Temporal Cloud instead of the bundled dev server
# TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=<namespace>.<account>
# TEMPORAL_API_KEY=
