{
  "name": "cutroom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cutroom": "tsx apps/cli/src/main.ts",
    "eval": "tsx evals/run-evals.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cutroom/agent": "workspace:*",
    "@cutroom/claim-audit": "workspace:*",
    "@cutroom/config": "workspace:*",
    "@cutroom/db": "workspace:*",
    "@cutroom/observability": "workspace:*",
    "@cutroom/pipeline": "workspace:*",
    "@cutroom/providers": "workspace:*",
    "@cutroom/repo-ingest": "workspace:*",
    "@cutroom/scene-spec": "workspace:*",
    "@cutroom/temporal": "workspace:*",
    "@cutroom/video-kit": "workspace:*",
    "@temporalio/client": "1.24.0",
    "@types/node": "22",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "vitest": "4.0.5",
    "zod": "4.6.7"
  }
}
