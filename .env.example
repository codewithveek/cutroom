# Copy to .env. Empty values mean "unset". See packages/config/src/env-schema.ts.
LOG_LEVEL=info
CUTROOM_DATA_DIR=.cutroom

# Local model (Ollama). Tag recorded in docs/decisions/0003-default-gemma-model.md
OLLAMA_HOST=http://127.0.0.1:11434
MODEL_ID=gemma4:e4b

# Cloud mode: Gemma behind an OpenAI-compatible endpoint (vLLM, DigitalOcean GPU Droplet)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL_ID=

# Voice
KOKORO_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_DTYPE=q8
ELEVENLABS_API_KEY=

# API / remote render
API_PORT=4100
WEB_ORIGIN=http://localhost:3000
RENDER_API_BASE_URL=
RENDER_API_TOKEN=

# Rendering: path to a Chromium headless shell (optional; Remotion downloads one otherwise)
BROWSER_EXECUTABLE=

# Observability
SENTRY_DSN=
